pipeline {
    agent any

    parameters {
        string(name: 'App_Version', defaultValue: 'v1', description: 'Application Tag')
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/patilcloud11/JAVA-SPRINGBOT-PROJECT-New.git'
            }
        }

        stage('Build Backend Image') {
            steps {
                sh 'docker build -t datastore:${App_Version} ./backend'
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh 'docker build -t frontend:${App_Version} ./frontend'
            }
        }

        stage('Deploy Containers') {
            steps {
                sh '''
                docker stop backend-container || true
                docker rm backend-container || true
                docker stop frontend-container || true
                docker rm frontend-container || true

                docker run -d -p 8080:8080 --name backend-container datastore:${App_Version}
                docker run -d -p 3000:3000 --name frontend-container frontend:${App_Version}
                '''
            }
        }
    }
}
