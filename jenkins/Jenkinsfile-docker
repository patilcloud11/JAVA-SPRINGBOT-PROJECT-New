pipeline {
    agent any

    environment {
        REPO_URL = "https://github.com/patilcloud11/JAVA-SPRINGBOT-PROJECT-New.git"
        BACKEND_IMAGE = "springboot-backend"
        FRONTEND_IMAGE = "react-frontend"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        // ✅ YOUR REQUESTED STAGE — git clone
        stage('Git Clone Source Code') {
            steps {
                sh "git clone ${REPO_URL}"
            }
        }

        stage('Move Into Repo') {
            steps {
                dir('JAVA-SPRINGBOT-PROJECT-New') {
                    sh 'ls -la'
                }
            }
        }

        // ===============================
        // BACKEND BUILD
        // ===============================
        stage('Build Backend') {
            steps {
                dir('JAVA-SPRINGBOT-PROJECT-New/backend') {
                    sh './mvnw clean package -DskipTests || mvn clean package -DskipTests'
                }
            }
        }

        // ===============================
        // FRONTEND BUILD
        // ===============================
        stage('Build Frontend') {
            steps {
                dir('JAVA-SPRINGBOT-PROJECT-New/frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }

        // ===============================
        // DOCKER BUILD
        // ===============================
        stage('Docker Build Images') {
            steps {
                dir('JAVA-SPRINGBOT-PROJECT-New/backend') {
                    sh "docker build -t ${BACKEND_IMAGE}:latest ."
                }

                dir('JAVA-SPRINGBOT-PROJECT-New/frontend') {
                    sh "docker build -t ${FRONTEND_IMAGE}:latest ."
                }
            }
        }

        // ===============================
        // RUN CONTAINERS
        // ===============================
        stage('Run Containers') {
            steps {
                dir('JAVA-SPRINGBOT-PROJECT-New/compose') {
                    sh '''
                        docker-compose down || true
                        docker-compose up -d --build
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful!"
        }
        failure {
            echo "❌ Pipeline Failed!"
        }
    }
}
