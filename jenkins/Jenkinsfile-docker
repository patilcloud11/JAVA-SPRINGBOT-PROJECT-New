pipeline {
    agent any

    parameters {
        string(name: 'App_Version', defaultValue: 'v1', description: 'Application Tag')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/patilcloud11/JAVA-SPRINGBOT-PROJECT-New.git'
            }
        }

        stage('Build Backend Image') {
            steps {
                sh "docker build --no-cache -t datastore:new ./backend"
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh "docker build -t frontend:${params.App_Version} ./frontend"
            }
        }

        stage('Deploy Containers') {
             steps {
             sh """
                 docker kill \$(docker ps -q) 2>/dev/null || true
                 docker rm \$(docker ps -aq) 2>/dev/null || true

                 docker run -d -p 9090:8084 --name backend-container datastore:new
                 docker run -d -p 3000:3000 --name frontend-container frontend:${params.App_Version}
               """
            }
        }
    }
}
